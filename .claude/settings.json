{
  "enabledPlugins": {
    "vercel@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "codex@openai-codex": true
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "opus"
  },
  "skillOverrides": {
    "agents-sdk": "off",
    "cloudflare": "off",
    "cloudflare-email-service": "off",
    "cloudflare-one": "off",
    "cloudflare-one-migrations": "off",
    "durable-objects": "off",
    "sandbox-sdk": "off",
    "turnstile-spin": "off",
    "workers-best-practices": "off",
    "wrangler": "off"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git ls-files *)",
      "Bash(git rev-parse *)",
      "Bash(git remote -v)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull --ff-only*)",
      "Bash(git merge origin/main*)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git worktree *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh label *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "Bash(npm run lint*)",
      "Bash(node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/*.test.ts)",
      "Bash(node .claude/hooks/session-start.mjs)",
      "Bash(codex exec *)",
      "Bash(git branch -D *)",
      "Bash(git -C * status *)",
      "Bash(git -C * diff *)",
      "Bash(git -C * log *)",
      "Bash(git -C * branch *)",
      "Bash(git -C * rev-parse *)",
      "Bash(git -C * fetch *)",
      "Bash(git -C * add *)",
      "Bash(git -C * commit *)",
      "Bash(git -C * push *)",
      "Bash(git -C * merge origin/main*)",
      "Bash(sleep *)",
      "Bash(gh pr merge * --auto --squash)",
      "Bash(gh pr merge * --disable-auto)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git ls-files *)",
      "PowerShell(git rev-parse *)",
      "PowerShell(git remote -v)",
      "PowerShell(git branch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git fetch *)",
      "PowerShell(git pull --ff-only*)",
      "PowerShell(git merge origin/main*)",
      "PowerShell(git checkout -b *)",
      "PowerShell(git switch *)",
      "PowerShell(git worktree *)",
      "PowerShell(gh pr *)",
      "PowerShell(gh issue *)",
      "PowerShell(gh run *)",
      "PowerShell(gh api *)",
      "PowerShell(gh label *)",
      "PowerShell(npx tsc *)",
      "PowerShell(npx eslint *)",
      "PowerShell(npm run lint*)",
      "PowerShell(node --env-file=.env.local node_modules/vitest/vitest.mjs run tests/*.test.ts)",
      "PowerShell(node .claude/hooks/session-start.mjs)",
      "PowerShell(git branch -D *)",
      "PowerShell(git -C * status *)",
      "PowerShell(git -C * diff *)",
      "PowerShell(git -C * log *)",
      "PowerShell(git -C * branch *)",
      "PowerShell(git -C * rev-parse *)",
      "PowerShell(git -C * fetch *)",
      "PowerShell(git -C * add *)",
      "PowerShell(git -C * commit *)",
      "PowerShell(git -C * push *)",
      "PowerShell(git -C * merge origin/main*)",
      "PowerShell(sleep *)",
      "PowerShell(gh pr merge * --auto --squash)",
      "PowerShell(gh pr merge * --disable-auto)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 600
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.mjs\"",
            "timeout": 600
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/after-edit.mjs\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
