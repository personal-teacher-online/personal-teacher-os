{
  "name": "personal-teacher-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "e2e:bancada": "npx supabase db reset && sleep 60 && node --env-file=.env.local scripts/preview-logins.ts && node --env-file=.env.local scripts/preview-seed.ts && next build",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "bootstrap:admin": "node --env-file=.env.local scripts/bootstrap-admin.ts",
    "worker:audit": "node --env-file=.env.local worker/audit-pipeline.ts",
    "worker:pesquisa": "node --env-file=.env.local worker/research-pipeline.ts",
    "worker:pesquisa:prod": "node --env-file=.env.local --env-file=.env.production worker/research-pipeline.ts",
    "mcp": "node mcp/server.ts",
    "asaas:semear": "node --env-file=.env.local scripts/asaas-semear-external-reference.ts",
    "asaas:semear:prod": "node --env-file=.env.local --env-file=.env.production scripts/asaas-semear-external-reference.ts",
    "asaas:reconciliar": "node --env-file=.env.local scripts/asaas-reconciliar.ts",
    "asaas:reconciliar:prod": "node --env-file=.env.local --env-file=.env.production scripts/asaas-reconciliar.ts",
    "asaas:enriquecer": "node --env-file=.env.local scripts/asaas-enriquecer-pagadores.ts",
    "asaas:enriquecer:prod": "node --env-file=.env.local --env-file=.env.production scripts/asaas-enriquecer-pagadores.ts",
    "evolution:amostra:prod": "node --env-file=.env.local --env-file=.env.production scripts/evolution-sonda.cjs --amostra",
    "prompts:publish": "node --env-file=.env.local scripts/publish-prompts.ts",
    "slides:assets": "node scripts/slides/build-assets.ts",
    "slides:template": "node scripts/slides/build-template.ts",
    "slides:render": "node scripts/slides/render-lesson.ts",
    "chunks:pdf": "node scripts/chunks/build-pdf.ts",
    "textos:revisao": "node --import ./scripts/carregador-alias.mjs scripts/textos-revisao.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^173.0.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.25.0",
    "luxon": "^3.7.2",
    "next": "16.2.10",
    "openai": "^6.46.0",
    "pg": "^8.22.0",
    "pptxgenjs": "^3.12.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.12.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jose": "^6.2.3",
    "jsdom": "^30.0.0",
    "playwright": "^1.61.1",
    "postgres": "^3.4.9",
    "satori": "^0.29.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  }
}
