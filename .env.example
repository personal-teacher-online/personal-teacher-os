# ============================================================================
# Personal Teacher OS — mapa de variáveis de ambiente (01/09/2026)
#
# Este arquivo NÃO é lido por nada: é o inventário. Copie para `.env.local`
# (bancada) e preencha. Valores reais vivem no Bitwarden e nas envs do app no
# Coolify (produção). Segredo NUNCA entra no repo (.gitignore cobre .env*).
#
# Legenda "onde":  [bancada] só local · [app] env do container em produção ·
#                  [dono] scripts rodados da máquina do dono (`:prod`
#                  carrega `.env.production` por cima do `.env.local`).
# Toda integração é fail-closed: sem a env, o app diz "integração desligada".
# ============================================================================

# --- Supabase --------------------------------------------------------------
# [bancada+app] URL e anon key vão INLINADAS no bundle no build (build-args).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# [bancada+app] Lei 4: service_role SÓ no servidor. NUNCA NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# [dono] alias aceito por workers/scripts quando NEXT_PUBLIC_SUPABASE_URL não está definida
SUPABASE_URL=
# [bancada] Postgres direto para a suíte Vitest e scripts de seed
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# [bancada] `scripts/preview-seed.ts` (recusa host que não seja local)
PREVIEW_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# [dono] MCP server (`npm run mcp`): usuário Postgres de permissão LIMITADA
DATABASE_URL_MCP=

# --- App / sessão ------------------------------------------------------------
# [app] `true` em produção (cookies Secure). Em http:// local deixe vazio.
COOKIE_SECURE=
# [bancada] entrada automática `/dev-entrar?chave=…&como=…`. JAMAIS em produção.
BANCADA_AUTOLOGIN=
# [app] WhatsApp de ATENDIMENTO (o que a dona responde — não o número que dispara os
# avisos), só dígitos com DDI e DDD. Dado pessoal: NÃO versionar o número.
# OBRIGATÓRIO para os avisos de WhatsApp desde a #43: o "fale com a gente" é parâmetro
# dos modelos aprovados na Meta (lembrete de 48h, cancelamento, remarcação, reposição,
# briefing, encontro cancelado, mentoria liberada). Vazio = essas linhas ficam presas em
# Mensagens com o motivo, e o portal fica sem link de WhatsApp.
WHATSAPP_ATENDIMENTO_E164=
# [app] primeiro nome da dona na saudação do admin, quando o perfil não tem nome
# (vazio = "Professora")
SCHOOL_OWNER_NAME=
# [app] identificador assinado nos cartões de Instagram (vazio = "@escola")
CONTENT_HANDLE=
# [bancada] pastas de marca e de conteúdo lidas pelo motor de slides (CLI).
# Vazio = a pasta dentro do repositório (brand/, content/) enquanto existir; senão
# ../personal-teacher-os-privado/brand e /content. Se preenchida e inexistente, falha.
PT_BRAND_DIR=
PT_CONTENT_DIR=

# --- Tokens dos jobs (Scheduled Tasks do Coolify → POST /api/jobs/*) ----------
# [app] cada rota exige o header com o token; sem env = 401
OUTBOX_DISPATCH_TOKEN=
GCAL_SYNC_TOKEN=
HOTMART_SYNC_TOKEN=
AUDIT_RECORDINGS_TOKEN=
CONTENT_GENERATE_TOKEN=
# [app] teto de roteiros por corrida do gerador (1–5; padrão 2)
CONTENT_GENERATE_MAX=
# [app] token das rotas /api/content/* usadas pelo worker de pesquisa
CONTENT_API_TOKEN=

# --- E-mail (Resend) -----------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="Personal Teacher Academy <contato@personal-teacher.com>"
# [app] assinatura Svix do webhook de bounce (/api/webhooks/resend)
RESEND_WEBHOOK_SECRET=

# --- WhatsApp (Cloud API da Meta — ADR-038; passo a passo no runbook §AN) ------
# Só no servidor (Lei 4): nenhuma destas vira NEXT_PUBLIC_*. Sem o token ou o id
# do número, os avisos de WhatsApp ficam pendentes com o motivo (fail-closed).
# [app] token de sistema do app na Meta (Authorization: Bearer)
WHATSAPP_CLOUD_TOKEN=
# [app] id do número da escola na Cloud API (POST /<id>/messages)
WHATSAPP_PHONE_NUMBER_ID=
# [app] id da conta do WhatsApp Business (submissão dos templates)
WHATSAPP_WABA_ID=

# --- WhatsApp (Evolution API — ADR-016; sem uso desde a #43, sai na #45) --------
EVOLUTION_URL=
EVOLUTION_INSTANCE=personal-teacher
EVOLUTION_API_KEY=
# [app] header `evolution-webhook-token` da recepção (/api/webhooks/evolution)
EVOLUTION_WEBHOOK_TOKEN=

# --- Asaas (pagamentos) — religamento = runbook §N.3, ordem obrigatória --------
# [app] token conferido no webhook; também configurado no painel do Asaas
ASAAS_WEBHOOK_TOKEN=
# [app+dono] key da API. `producao` SÓ no religamento (F6); antes, só sandbox.
ASAAS_API_KEY=
ASAAS_ENV=sandbox

# --- Autentique (assinatura de contratos — ADR-029) ------------------------------
# [app] sem o token a superfície de assinatura fica DESLIGADA na tela
AUTENTIQUE_TOKEN=
# [bancada] `1` aponta para o sandbox
AUTENTIQUE_SANDBOX=
# [app] só se um dia houver plano Pro (webhook HMAC). Hoje: NÃO cadastrar.
AUTENTIQUE_WEBHOOK_SECRET=

# --- Hotmart (mentoria — Fase 5) ------------------------------------------------
HOTMART_CLIENT_ID=
HOTMART_CLIENT_SECRET=
HOTMART_BASIC=
HOTMART_SUBDOMAIN=
# [app] HOTTOK conferido no webhook (/api/webhooks/hotmart)
HOTMART_HOTTOK=

# --- Google ---------------------------------------------------------------------
# [app] OAuth por professora (Agenda — ADR-017)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=https://app.personal-teacher.com/teacher/google/callback
# [app] chave que cifra os refresh tokens guardados no banco
GOOGLE_TOKEN_KEY=
# [app+dono] service account (Slides/Drive/gravações). JSON cru OU base64.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_B64=
# [app] relatórios de progresso: template de Slides (NUNCA editar) + pasta destino
SLIDES_TEMPLATE_ID=
SLIDES_FOLDER_ID=
# [dono] pasta fixa dos decks do Personal Travel (motor de slides por CLI)
PT_SLIDES_FOLDER_ID=
# [app] auditoria de gravações do Meet: pasta no Drive + retenção em dias
AUDIT_RECORDINGS_FOLDER_ID=
AUDIT_RETAIN_DAYS=
# [app] fábrica de conteúdo: pasta de entrega + pasta de referências no Drive
CONTENT_DRIVE_FOLDER_ID=
CONTENT_DRIVE_REFS_FOLDER_ID=

# --- IA e mídia -----------------------------------------------------------------
# [app] rotinas Claude (auditoria, relatórios, roteiros)
ANTHROPIC_API_KEY=
# [dono] worker de auditoria (transcrição) e pesquisa
OPENAI_API_KEY=
# [app+dono] fotos de aula (Nano Banana — ADR-023) e análise de pesquisa
GEMINI_API_KEY=
GEMINI_MODELO=
# [dono] Higgsfield (marca e vídeo). `HF_CREDENTIALS=key:secret` OU o par abaixo
HF_CREDENTIALS=
HF_API_KEY=
HF_API_SECRET=
# [dono] curadoria de vídeos (scripts de slides e spike da pauta)
YOUTUBE_API_KEY=
# [dono] worker de pesquisa (Apify)
APIFY_TOKEN=
# [app] binário do yt-dlp (padrão `yt-dlp` no PATH; a imagem Docker já instala)
YTDLP_PATH=

# --- Scripts do dono ---------------------------------------------------------------
# [dono] `npm run prompts:publish` — conta ADMIN operacional (NUNCA a da Victória)
PROMPTS_ADMIN_EMAIL=
PROMPTS_ADMIN_PASSWORD=
# [bancada] export de telas (`scripts/export-screens-local.mjs`)
BASE_URL=http://127.0.0.1:3000
# [dono] scripts de imagens: tamanho do lote e modelo da conferência
LOTE=
MODELO_CONFERENCIA=
